  author = {Lyu, Chenyang and Du, Zefeng and Xu, Jitao and Duan, Yitao and Wu, Minghao and Lynn, Teresa and Aji, Alham Fikri and Wong, Derek F. and Liu, Siyou and Wang, Longyue},
  year = 2024,
