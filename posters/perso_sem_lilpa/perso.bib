@misc{huangAutoScraperProgressiveUnderstanding2024,
  title = {{{AutoScraper}}: {{A Progressive Understanding Web Agent}} for {{Web Scraper Generation}}},
  shorttitle = {{{AutoScraper}}},
  author = {Huang, Wenhao and Gu, Zhouhong and Peng, Chenghao and Li, Zhixu and Liang, Jiaqing and Xiao, Yanghua and Wen, Liqian and Chen, Zulong},
  year = 2024,
