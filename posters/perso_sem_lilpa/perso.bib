@article{heapMasculinosNoTan2024,
  title = {Los Masculinos No Tan ``Gen\'ericos'': Estudios Emp\'iricos Sobre Interpretaciones En Espa\~nol y En Franc\'es},
  shorttitle = {Los Masculinos No Tan ``Gen\'ericos''},
  author = {Heap, David},
