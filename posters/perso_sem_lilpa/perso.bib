@misc{zhaoGenderBiasLarge2024,
  title = {Gender {{Bias}} in {{Large Language Models}} across {{Multiple Languages}}},
  author = {Zhao, Jinman and Ding, Yitian and Jia, Chen and Wang, Yining and Qian, Zifan},
