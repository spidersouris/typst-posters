  shorttitle = {Alignment and {{Safety}} in {{Large Language Models}}},
  author = {Lu, Haoran and Fang, Luyang and Zhang, Ruidong and Li, Xinliang and Cai, Jiazhang and Cheng, Huimin and Tang, Lin and Liu, Ziyu and Sun, Zeliang and Wang, Tao and Zhang, Yingchuan and Zidan, Arif Hassan and Xu, Jinwen and Yu, Jincheng and Yu, Meizhi and Jiang, Hanqi and Gong, Xilin and Luo, Weidi and Sun, Bolun and Chen, Yongkai and Ma, Terry and Wu, Shushan and Zhou, Yifan and Chen, Junhao and Xiang, Haotian and Zhang, Jing and Jahin, Afrar and Ruan, Wei and Deng, Ke and Pan, Yi and Wang, Peilong and Li, Jiahui and Liu, Zhengliang and Zhang, Lu and Zhao, Lin and Liu, Wei and Zhu, Dajiang and Xing, Xin and Dou, Fei and Zhang, Wei and Huang, Chao and Liu, Rongjie and Zhang, Mengrui and Liu, Yiwen and Sun, Xiaoxiao and Lu, Qin and Xiang, Zhen and Zhong, Wenxuan and Liu, Tianming and Ma, Ping},
  year = 2025,
