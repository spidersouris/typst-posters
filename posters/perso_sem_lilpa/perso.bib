@misc{liPreliminaryStudyRobustness2025,
  title = {A {{Preliminary Study}} on the {{Robustness}} of {{Code Generation}} by {{Large Language Models}}},
  author = {Li, Zike and Liu, Mingwei and Li, Anji and He, Kaifeng and Wang, Yanlin and Peng, Xin and Zheng, Zibin},
  year = 2025,
