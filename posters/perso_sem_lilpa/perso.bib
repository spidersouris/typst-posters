@book{viennotLAcademieContreLangue2016,
  title = {{L'Acad\'emie contre la langue fran\c caise : le dossier f\'eminisation}},
  shorttitle = {{L'Acad\'emie contre la langue fran\c caise}},
  author = {Viennot, {\'E}liane},
  year = 2016,
  series = {{Xx-y-z}},
  publisher = {\'Editions iXe},
  address = {Donnemarie-Dontilly},
  abstract = {En trois si\`ecles et demi d'existence, l'Acad\'emie a beaucoup travaill\'e \`a masculiniser le fran\c cais. Porte-\-banni\`ere des partisans du << genre le plus noble >>, ce vestige de la monarchie absolue m\`ene depuis le milieu des ann\'ees 1980 une croisade contre la << f\'eminisation >>, en d\'epit des besoins langagiers d'une soci\'et\'e o\`u l'\'egalit\'e des sexes progresse -- en d\'epit, surtout, des logiques de la langue fran\c caise et des \'evolutions \`a l'\oe uvre dans les autres pays francophones. Sans se soucier de remplir le r\^ole pour lequel l'entretiennent les contribuables, les Immortel{$\cdot$}les en habit vert campent sur des positions purement id\'eologiques, en prof\'erant des sentences qui se veulent paroles d'\'Evangile alors qu'elles vont \`a rebours des dynamiques du fran\c cais.Les << Quarante >>, il est vrai, ne sont ni grammairiens, ni linguistes, ni philologues -- et pas toujours \'ecrivains. Ce livre retrace cette guerre de trente ans, men\'ee \`a coup de d\'eclarations aussi p\'eremptoires qu'infond\'ees, r\'eactionnaires et sexistes, face auxquelles les protestations n'ont pas manqu\'e. Il permet \'egalement de faire le point sur les objets de ces controverses, et de comprendre pourquoi la France a fini par entamer sa << r\'evolution langagi\`ere >>\dots{} envers et contre les avis des Messieurs-Dames du Quai Conti},
