@misc{hossainLyingOnlySinful2025,
  title = {Is {{Lying Only Sinful}} in {{Islam}}? {{Exploring Religious Bias}} in {{Multilingual Large Language Models Across Major Religions}}},
  shorttitle = {Is {{Lying Only Sinful}} in {{Islam}}?},
  author = {Hossain, Kazi Abrab and Mahmud, Jannatul Somiya and Tuli, Maria Hossain and Mitra, Anik and Haque, S. M. Taiabul and Sadeque, Farig Y.},
