  abstract = {This study used the visual world eye-tracking method to investigate activation of general world knowledge related to gender-stereotypical role names in online spoken language comprehension in Finnish. The results showed that listeners activated gender stereotypes elaboratively in story contexts where this information was not needed to build coherence. Furthermore, listeners made additional inferences based on gender stereotypes to revise an already established coherence relation. Both results are consistent with mental models theory (e.g., Garnham, 2001 ). They are harder to explain by the minimalist account ( McKoon \& Ratcliff, 1992 ), which suggests that people limit inferences to those needed to establish coherence in discourse.},
  langid = {english}
}

