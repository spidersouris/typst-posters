@article{casasantoWhosAfraidBig2008,
  title = {Who's {{Afraid}} of the {{Big Bad Whorf}}? {{Crosslinguistic Differences}} in {{Temporal Language}} and {{Thought}}},
  shorttitle = {Who's {{Afraid}} of the {{Big Bad Whorf}}?},
  author = {Casasanto, Daniel},
  year = 2008,
