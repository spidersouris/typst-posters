@article{muthusamychinnanGenderInclusiveLanguage2025,
  title = {Gender Inclusive Language Generation Framework: {{A}} Reasoning Approach with {{RAG}} and {{CoT}}},
  shorttitle = {Gender Inclusive Language Generation Framework},
  author = {Muthusamy Chinnan, Shunmuga Priya and {Drury-Grogan}, Meghann and Chakravarthi, Bharathi Raja},
